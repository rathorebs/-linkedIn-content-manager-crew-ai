# Copy this file to .env and fill in your keys:  cp .env.example .env

# Anthropic (Claude) - https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Serper (Google Search API) - https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Optional: Claude model (default: claude-opus-5-5). Cheaper: claude-sonnet-5-5, claude-haiku-5-5
# CLAUDE_MODEL=claude-opus-5-5

# Optional: retries for transient API errors (default: 2)
# MAX_RETRIES=2
